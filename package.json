{
  "name": "budgeting-app-nuxt",
  "version": "1.0.0",
  "description": "A simple budgeting application built with Nuxt 3",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@tailwindcss/oxide",
      "@parcel/watcher",
      "unrs-resolver",
      "vue-demi"
    ]
  },
  "scripts": {
    "build": "prisma generate && nuxt build",
    "dev": "fuser -k 3000/tcp 2>/dev/null; prisma generate && nuxt dev",
    "dev:kill": "fuser -k 3000/tcp",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prisma:dev": "prisma generate",
    "prisma:prod": "prisma generate --no-engine",
    "windows:cleanup": "FOR /L %i IN (3000,1,3010) DO FOR /F \"tokens=5\" %P IN ('netstat -ano ^| findstr :%i 2^>nul') DO taskkill /F /PID %P 2>nul",
    "windows:cleanup:all": "taskkill /F /IM node.exe",
    "cleanup": "fuser -k 3000/tcp 2>/dev/null || true",
    "db:up": "docker compose --profile dev up -d",
    "db:down": "docker compose --profile dev down"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/ui": "^4.4.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@vueuse/core": "^14.0.0",
    "better-auth": "^1.6.22",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "marked": "^17.0.1",
    "nuxt": "^4.3.1",
    "pg": "^8.16.3",
    "resend": "^6.16.0",
    "tailwindcss": "^4.1.18",
    "v-calendar": "^3.1.2",
    "vue": "^3.5.26",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.16.0",
    "prisma": "^7.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.4"
  }
}
