# Environment variables template
# Copy to .env and fill in actual values
# .env is gitignored and contains real credentials

# Database connections (Prisma)
# Local dev: the docker-compose Postgres (pnpm db:up)
DATABASE_URL="postgresql://budgeting:budgeting_dev@localhost:5434/budgeting"
DIRECT_URL="postgresql://budgeting:budgeting_dev@localhost:5434/budgeting"

# better-auth (magic-link auth)
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The app's public origin (no trailing slash). Local: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# Mail — dev goes to local Mailpit (pnpm db:up; read at http://localhost:8422)
NUXT_SMTP_HOST="localhost"
NUXT_SMTP_PORT="1422"
NUXT_SMTP_USER=""
NUXT_SMTP_PASS=""
NUXT_SMTP_FROM="Budget App <noreply@send.wernerbuildsapps.co.za>"
