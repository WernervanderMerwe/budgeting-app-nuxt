# Environment variables template
# Copy to .env.local and fill in actual values
# .env.local is gitignored and contains real credentials

# Database connections (Prisma)
# Local dev: the docker-compose Postgres (npm run db:up)
DATABASE_URL="postgresql://budgeting:budgeting_dev@localhost:5434/budgeting"
DIRECT_URL="postgresql://budgeting:budgeting_dev@localhost:5434/budgeting"

# better-auth (magic-link auth)
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The app's public origin (no trailing slash). Local: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# Resend — magic-link email delivery (HTTP API, edge-safe)
RESEND_API_KEY=""
RESEND_FROM="Budget App <noreply@send.wernerbuildsapps.co.za>"
